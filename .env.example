# Miljövariabler som Netlify-funktionerna läser. Sätts i Netlify (produktion) och i en lokal .env för netlify dev.
# Lägg aldrig riktiga värden i repot.

# Supabase
SUPABASE_URL=https://ditt-projekt.supabase.co
SUPABASE_SERVICE_KEY=

# Inloggning (signerar och kontrollerar JWT)
JWT_SECRET=

# Admiral
BASE_URL=https://admiralai.se
ADMIN_EMAIL=
# Valfritt: admin-adressen om den inte är admin@admiralai.se
ADMIRAL_ADMIN_EMAIL=

# Meta-appen (OAuth)
META_APP_ID=
META_APP_SECRET=

# Mejl (Resend)
RESEND_API_KEY=
RESEND_FROM=

# GA4
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
GA4_BOKA_EVENT=

# Valfritt
# ADMIRAL_VISION_MODEL=claude-opus-5-5   (bildgranskning; AI via Netlify AI Gateway, ingen egen nyckel behövs)
# FORTNOX_ACCESS_TOKEN=                  (fakturering via MCP)
# INTERNAL_SERVICE_SECRET=
